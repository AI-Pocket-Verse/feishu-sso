# nginx snippet for feishu-sso: include it in the integrating site's server { } block so the
# login service shares the site's host name and integrating apps can read the login cookie.
# For example, save it as /etc/nginx/snippets/feishu-sso.conf and add one line to that
# server block: include /etc/nginx/snippets/feishu-sso.conf;

# Internal APIs (token-protected, only for business services on this machine) are not
# exposed publicly: business services call http://127.0.0.1:4020/api/feishu/<name> directly.
# Regex locations take precedence over the prefix locations below.
location ~ ^/auth/api/feishu/(notify|reply|reaction|upload-image)/?$ {
    return 404;
}

# API: /auth/api/* → the api's /api/* (Feishu callback, whoami, bot events, ...)
location /auth/api/ {
    proxy_pass http://127.0.0.1:4020/api/;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Real-IP         $remote_addr;
    # Overwrite instead of append: a client-supplied X-Forwarded-For cannot be trusted,
    # and rate limiting keyed on it could be bypassed
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Login page (build output)
location /auth/ {
    alias __INSTALL_DIR__/web/dist/;
    try_files $uri $uri/ /auth/index.html;
}

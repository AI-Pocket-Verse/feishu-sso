# 配置模板。复制为 .env.dev（pnpm dev 读取）或 .env.prod（pnpm start 读取）后填写，
# 两者都不入库。通过 Node 的 --env-file 加载，只支持 KEY=value，不支持变量替换。
# 每项的含义与取值位置见 README「配置」一节。

NODE_ENV=development
HOST=127.0.0.1
PORT=4020
# 信任哪些反向代理的 X-Forwarded-* 头（传给 Fastify trustProxy）：loopback、逗号分隔的
# IP / CIDR、跳数，或 true / false。nginx 与本服务同机时保持 loopback
TRUST_PROXY=loopback
# 登录页展示的站点名（留空用「统一登录」）
SITE_NAME=
# 飞书机器人卡片里的助手称呼（留空用「AI」）
ASSISTANT_NAME=

# 飞书开放平台 → 应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# 必须与飞书后台「安全设置 → 重定向 URL」里登记的地址完全一致
FEISHU_REDIRECT_URI=http://localhost:5020/auth/api/feishu/callback
# 空格分隔；必须是飞书后台已开通权限的子集。增加权限后，已登录用户会被要求重新登录一次
FEISHU_SCOPES=contact:user.base:readonly contact:user.email:readonly contact:user.id:readonly contact:user.phone:readonly docx:document:readonly docs:doc:readonly wiki:wiki:readonly wiki:node:read drive:drive:readonly board:whiteboard:node:read bitable:app:readonly sheets:spreadsheet:readonly

# 登录 cookie。名称要与接入方的配置一致，默认 sso_session
SESSION_COOKIE_NAME=sso_session
# 留空表示只对当前域名生效（推荐，与接入方同域部署）。跨子域共享时填如 .example.com
SESSION_COOKIE_DOMAIN=
# 生产环境（HTTPS）填 true；留空时开发环境为 false，其余环境为 true
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=lax
# 会话有效天数。登录页发起的登录恒为「记住我」，使用 SESSION_REMEMBER_TTL_DAYS；
# SESSION_TTL_DAYS 只在调用方显式传 remember_me=0 时生效。开启滑动续期时按「连续多少天不活动」计算
SESSION_TTL_DAYS=30
SESSION_REMEMBER_TTL_DAYS=30
SESSION_SLIDING=true

# 飞书 token 落库加密用的 32 字节密钥（base64）。pnpm bootstrap 会自动生成
# 手动生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_DATA_KEY=
# 登录后允许跳回的跨域地址（正则，空格分隔）。同域路径（如 /app/）和与请求同源的绝对 URL 始终允许
ALLOWED_RETURN_TO=^http://localhost:5\d{3}/
# 登录流程 state 的有效秒数
STATE_TTL_SECONDS=300
# 允许跨域调用的前端来源（空格分隔）。同域部署时留空
CORS_ORIGINS=

# 后台刷新飞书 user_access_token：提前多少分钟刷新、多久扫描一次
REFRESH_LOOKAHEAD_MINUTES=10
REFRESH_INTERVAL_MINUTES=30

# 服务间共享口令，接入方与对话后端必须配置成同一个值。生产环境必须改成强随机值；
# 留空 = 关闭内部接口（全部拒绝）；占位值只允许在监听本机的开发环境使用
# 生成：openssl rand -hex 24
INTERNAL_API_TOKEN=dev-internal-token-change-in-prod

# 飞书机器人事件订阅（可选）：开放平台 → 事件与回调 → 加密策略
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=
# 机器人的对话后端地址（可选），如 team-knowledge 的内网地址 http://127.0.0.1:4030
BOT_BACKEND_URL=

# SQLite 数据库，相对路径以 api/prisma/ 为基准；生产建议写绝对路径
DATABASE_URL=file:./dev.db

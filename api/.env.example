# Configuration template. Copy to .env.dev (read by `pnpm dev`) or .env.prod (read by
# `pnpm start` and docker-compose); neither is committed. Loaded with Node's --env-file:
# plain KEY=value only, no variable substitution.
# See the "Configuration" section of README.md for what each setting means.

NODE_ENV=development
HOST=127.0.0.1
PORT=4020
# Which reverse proxies to trust for X-Forwarded-* headers (passed to Fastify trustProxy):
# loopback, comma-separated IPs / CIDRs, or true / false. Hop counts are not supported.
# Keep loopback when nginx runs on the same machine
TRUST_PROXY=loopback
# Site name shown on the login page (empty = "统一登录" / "Single Sign-On" by UI language)
SITE_NAME=
# How the assistant is called in Feishu bot cards (empty = "AI")
ASSISTANT_NAME=
# Language of bot cards and button toasts: zh or en (empty = zh)
BOT_LANG=

# feishu = Feishu (China, feishu.cn); lark = Lark (international, larksuite.com)
FEISHU_DOMAIN=feishu
# Developer console → your app → Credentials & Basic Info
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# Must exactly match a redirect URL registered under Security Settings in the developer console
FEISHU_REDIRECT_URI=http://localhost:5020/auth/api/feishu/callback
# Space-separated; must be a subset of the scopes enabled for the app. Adding scopes asks
# signed-in users to sign in once more
FEISHU_SCOPES=contact:user.base:readonly contact:user.email:readonly contact:user.id:readonly contact:user.phone:readonly docx:document:readonly docs:doc:readonly wiki:wiki:readonly wiki:node:read drive:drive:readonly board:whiteboard:node:read bitable:app:readonly sheets:spreadsheet:readonly

# Login cookie. The name must match what integrating apps read (default sso_session)
SESSION_COOKIE_NAME=sso_session
# Empty = current host only (recommended, same host as integrating apps).
# To share across subdomains use e.g. .example.com
SESSION_COOKIE_DOMAIN=
# true in production (HTTPS); empty = false in development, true otherwise
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=lax
# Session lifetime in days. Logins from the login page are always "remember me" and use
# SESSION_REMEMBER_TTL_DAYS; SESSION_TTL_DAYS only applies when a caller passes
# remember_me=0. With sliding sessions this counts days of inactivity
SESSION_TTL_DAYS=30
SESSION_REMEMBER_TTL_DAYS=30
SESSION_SLIDING=true

# 32-byte key (base64) encrypting Feishu tokens at rest. `pnpm bootstrap` generates one.
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_DATA_KEY=
# Cross-origin destinations allowed after login (regexes, space-separated). Same-origin
# paths (e.g. /app/) and absolute URLs on the request's own origin are always allowed
ALLOWED_RETURN_TO=^http://localhost:5\d{3}/
# How long a login attempt's state stays valid, in seconds
STATE_TTL_SECONDS=300
# Frontend origins allowed to call whoami / logout cross-origin (space-separated).
# Leave empty for same-host deployments
CORS_ORIGINS=

# Background refresh of Feishu user_access_token: refresh this many minutes before
# expiry, scanning every N minutes
REFRESH_LOOKAHEAD_MINUTES=10
REFRESH_INTERVAL_MINUTES=30

# Shared secret between services; integrating apps and the chat backend must use the
# same value. Use a strong random value in production.
# Empty = internal APIs disabled (all rejected); the placeholder only works for local
# development on a loopback HOST. Generate: openssl rand -hex 24
INTERNAL_API_TOKEN=dev-internal-token-change-in-prod

# Feishu bot event subscription (optional): developer console → Events & Callbacks → Encryption Strategy
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_EVENT_VERIFICATION_TOKEN=
# Chat backend for the bot (optional), e.g. http://127.0.0.1:4030 on the internal network
BOT_BACKEND_URL=

# Single-port mode: serve the login page from this directory and accept /auth/api/*.
# Set by the Docker image; leave empty when nginx serves web/dist (see deploy/)
WEB_DIST_DIR=

# SQLite database. Relative paths are resolved from api/prisma/; use an absolute path in production
DATABASE_URL=file:./dev.db
